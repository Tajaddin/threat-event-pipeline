# Copy to .env. Defaults run everything locally with no authentication on the ingest API (empty key list).

# Ingest API keys accepted in X-API-Key (comma-separated). Empty = open, for local development only.
INGEST_API_KEYS=
# Events per minute per key (a batch of 500 costs 500).
INGEST_RATE_LIMIT_PER_MINUTE=600000

POSTGRES_PASSWORD=threat
GRAFANA_ADMIN_PASSWORD=change-me

# Consumer concurrency per service (<= partitions: 6 for events.raw and events.enriched)
ENRICH_CONCURRENCY=3
DETECT_CONCURRENCY=3
INDEX_CONCURRENCY=2

OPENSEARCH_HEAP=1g

# Host ports
INGEST_PORT=8081
ENRICH_PORT=8082
DETECT_PORT=8083
INDEX_PORT=8084
CONSOLE_PORT=4200
KAFKA_PORT=29092
POSTGRES_PORT=5435
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601
PROMETHEUS_PORT=9093
ALERTMANAGER_PORT=9096
GRAFANA_PORT=3004
KAFKA_EXPORTER_PORT=9308
