#!/bin/sh
# Sourced by the nginx image's entrypoint before the templates are rendered; every variable the template uses
# must be set here, or nginx would read the placeholder as one of its own variables.
# The DNS server the container itself uses (Docker's embedded DNS in Compose, the cluster DNS on Kubernetes)
# becomes nginx's resolver.
export DNS_RESOLVER="${DNS_RESOLVER:-$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf)}"
# Sent to detect-service as X-API-Key, so the key stays on the server. Empty sends no header (local only).
export DETECT_API_KEY="${DETECT_API_KEY:-}"
